    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  }
}
